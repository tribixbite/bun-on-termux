#!/data/data/com.termux/files/usr/bin/bash
# Bunx wrapper for Termux — delegates to `bun x` which handles
# package execution natively through the C wrapper + shim.
#
# This is a thin wrapper. The main bun wrapper (bun-minimal) and
# bun-termux C binary handle all the heavy lifting.

exec "$HOME/.bun/bin/bun" x "$@"
