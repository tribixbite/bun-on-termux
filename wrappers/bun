#!/data/data/com.termux/files/usr/bin/bash
# Bun wrapper for Termux with C userland exec backend
# Handles: argument routing, --cwd injection, package.json script parsing,
# and stderr filtering. The C wrapper (bun-termux) handles env vars, shim
# preloading, and ld.so invocation natively.

_BUNX="$HOME/.bun/bin/bun-termux"
_BUNFIG="--config=$HOME/.bun/bin/bunfig.toml"
_ORIG_CWD="$(pwd)"

# Convert a potentially relative path to absolute using original CWD
_abs_path() {
    local p="$1"
    if [ "${p#/}" = "$p" ]; then
        echo "${_ORIG_CWD}/${p}"
    else
        echo "$p"
    fi
}

# Convert all file-like args to absolute paths
_resolve_args() {
    _ABS_ARGS=()
    for arg in "$@"; do
        if [ "${arg#-}" = "$arg" ] && [ -f "$(_abs_path "$arg")" ]; then
            _ABS_ARGS+=("$(_abs_path "$arg")")
        else
            _ABS_ARGS+=("$arg")
        fi
    done
}

# Run buno via C wrapper for JS execution
_bun_js() {
    _resolve_args "$@"
    exec "$_BUNX" "$_BUNFIG" "${_ABS_ARGS[@]}" 2> >(grep -v "Cannot read directory" >&2)
}

# Run buno via C wrapper for non-JS commands (install, etc.)
_bun_cmd() {
    _resolve_args "$@"
    exec "$_BUNX" "$_BUNFIG" "${_ABS_ARGS[@]}" 2> >(grep -v "Cannot read directory" >&2)
}

# --- Passthrough flags that don't need config ---
case "$1" in
    --version|--revision|--help|-h)
        exec "$_BUNX" "$1"
        ;;
esac

# --- bun run <script-name|file> ---
if [ "$1" = "run" ] && [ -n "$2" ]; then
    # Check if $2 is a file path
    target="$(_abs_path "$2")"
    if [ -f "$target" ]; then
        shift 2
        _bun_js "$target" "$@"
    fi

    # Try package.json scripts
    pjson="$(_abs_path package.json)"
    if [ -f "$pjson" ]; then
        script_name="$2"
        script_command=$(grep -o "\"${script_name}\":[[:space:]]*\"[^\"]*\"" "$pjson" 2>/dev/null \
            | sed 's/.*: *"\([^"]*\)".*/\1/')

        if [ -n "$script_command" ]; then
            shift 2  # Remove "run" and script name, keep extra args

            # Script invokes bun: route through wrapper
            if echo "$script_command" | grep -q "^bun run "; then
                script_file="$(_abs_path "${script_command#bun run }")"
                _bun_js "$script_file" "$@"
            elif echo "$script_command" | grep -q "^bun "; then
                _bun_js ${script_command#bun } "$@"
            else
                # Shell command: execute in Termux shell (has native env vars)
                # Add node_modules/.bin to PATH (same as npm/bun do natively)
                cd "$_ORIG_CWD" 2>/dev/null
                export PATH="${_ORIG_CWD}/node_modules/.bin:$PATH"
                if [ $# -gt 0 ]; then
                    eval "$script_command" '"$@"'
                else
                    eval "$script_command"
                fi
                exit $?
            fi
        fi
    fi
fi

# --- bun <file> (direct file execution) ---
if [ -n "$1" ] && [ "${1#-}" = "$1" ]; then
    target="$(_abs_path "$1")"
    if [ -f "$target" ]; then
        shift
        _bun_js "$target" "$@"
    fi
fi

# --- Commands that execute JS ---
case "$1" in
    test|eval|repl|build) _bun_js "$@" ;;
    -e|-p|--eval|--print) _bun_js "$@" ;;
esac

# --- bunx / bun x ---
if [ "$1" = "x" ]; then
    shift
    [ -n "$1" ] && _bun_cmd x "$@" || _bun_cmd x --help
fi

# --- Package management (install, add, remove, update) ---
# Must pass --cwd and --backend=copyfile because Android f2fs blocks hardlinks.
if [ "$1" = "install" ] || [ "$1" = "i" ] || [ "$1" = "add" ] || [ "$1" = "remove" ] || [ "$1" = "rm" ] || [ "$1" = "update" ]; then
    has_global=false
    has_backend=false
    has_cwd=false
    for arg in "$@"; do
        case "$arg" in
            -g|--global) has_global=true ;;
            --backend=*) has_backend=true ;;
            --cwd|--cwd=*) has_cwd=true ;;
        esac
    done
    _extra_args=()
    if [ "$has_backend" = false ]; then
        _extra_args+=(--backend=copyfile)
    fi
    if [ "$has_global" = false ] && [ "$has_cwd" = false ]; then
        _extra_args+=(--cwd "$_ORIG_CWD")
    fi
    _bun_cmd "$@" "${_extra_args[@]}"
fi

# --- Default: pass through ---
_bun_js "$@"
